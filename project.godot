; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vulnus"
config/description="Vulnus"
run/main_scene="res://scenes/Startup.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Vulnus"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://assets/images/beatgamedev.png"
config/icon="res://assets/images/vulnus.png"
config/windows_native_icon="res://assets/images/vulnus.ico"
config/use_custom_user_dir.Android=false

[audio]

default_bus_layout="res://assets/audiobus.tres"

[autoload]

Global="*res://scripts/Global.cs"

[display]

window/size/width=1600
window/size/height=900
window/size/test_width=1600
window/size/test_height=900
window/vsync/use_vsync=false
window/tablet_driver=""

[editor]

script_templates_search_path="res://templates"

[editor_plugins]

enabled=PackedStringArray()

[gdnative]

singletons=["res://addons/godot-openxr/config/godot_openxr.gdnlib"]
singletons_disabled=["res://addons/godot-openxr/config/godot_openxr.gdnlib"]

[global]

accum=false

[gui]

timers/tooltip_delay_sec=0.3

[input]

options={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
skip={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
force_end={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[input_devices]

buffering/agile_event_flushing=true
pointing/ios/touch_delay=0.0

[layer_names]

3d_render/layer_1="Playarea"
3d_render/layer_2="HUD"
3d_render/layer_3="Notes"
3d_render/layer_4="Obstacles"

[locale]

locale_filter=[1, ["en_GB", "en_US", "fr"]]

[mono]

profiler/enabled=true
project/assembly_name="Vulnus"

[physics]

3d/default_gravity_vector=Vector3(0, 0, 0)
common/physics_fps=120
common/enable_pause_aware_picking=true

[rendering]

quality/driver/fallback_to_gles2=true
threads/thread_model=2
vram_compression/import_etc=true
quality/filters/anisotropic_filter_level=2
environment/default_clear_color=Color(0, 0.0941176, 0.188235, 1)
quality/filters/msaa=1
quality/filters/use_debanding=true
environment/default_environment="res://assets/environments/Environment.tres"
quality/intended_usage/framebuffer_allocation.Quest=2
quality/depth/hdr.Quest=true
